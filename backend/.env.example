# Example env for local/dev. Do NOT commit real secrets.

# Server
PORT=3000
NODE_ENV=development

# Postgres (docker compose uses service name `postgres` internally)
DATABASE_URL=postgresql://admin:adminpassword@postgres:5432/cicloleve?schema=public

# Redis (docker compose uses service name `redis` internally)
REDIS_URL=redis://redis:6379

# Auth
JWT_SECRET=dev-change-me
JWT_REFRESH_SECRET=dev-change-me-too

# CORS
CORS_ORIGIN=*
