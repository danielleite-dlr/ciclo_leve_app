# Expo public env vars
# Ajuste conforme seu ambiente. O app lê via process.env.EXPO_PUBLIC_API_URL

# Android Emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api/v1

# iOS Simulator:
# EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Device físico na mesma rede:
# EXPO_PUBLIC_API_URL=http://192.168.x.x:3000/api/v1

# Túnel (ngrok/cloudflared):
# EXPO_PUBLIC_API_URL=https://<seu-tunel>/api/v1
