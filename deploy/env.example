# Copie para deploy/.env e preencha. O .env nunca vai para o Git.
# Gere cada senha/segredo com:  openssl rand -hex 32
# (use so letras e numeros na senha do banco: ela entra numa URL)

# Banco
POSTGRES_USER=cicloleve
POSTGRES_PASSWORD=
POSTGRES_DB=cicloleve

# Login (segredos diferentes entre si)
JWT_SECRET=
JWT_REFRESH_SECRET=

# Endereco publico da API, sem https:// (ex.: api.seudominio.com.br)
API_DOMINIO=

# Porta local da API no servidor (o proxy HTTPS aponta para ela). Mude se 3000 estiver ocupada.
API_PORTA=3000

# CORS: origem(ns) do site/app que acessam a API pelo navegador, separadas por virgula
# (ex.: https://cicloleve.com.br,https://www.cicloleve.com.br).
# O app mobile nativo nao passa por CORS. Deixe vazio ou "*" para liberar geral.
CORS_ORIGIN=*

# Cobranca pela loja (RevenueCat > Project settings > API keys)
# Chave publica do app Android (comeca com goog_). Vai para o app pela API.
REVENUECAT_ANDROID_KEY=
# Chave secreta v1 (comeca com sk_). Nunca vai para o app.
REVENUECAT_SECRET_KEY=
# Valor exato do cabecalho Authorization configurado no webhook do RevenueCat
# (ex.: Bearer <openssl rand -hex 32>)
REVENUECAT_WEBHOOK_AUTH=
# true libera a compra simulada, sem loja. Deixe false em producao.
COMPRA_SIMULADA=false
