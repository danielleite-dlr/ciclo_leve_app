{
  "expo": {
    "name": "CicloLeve",
    "slug": "ciclo-leve",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cicloleve",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FBE0E9"
      },
      "package": "com.cicloleve.app",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permita que o CicloLeve use o Face ID para proteger seus dados."
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "O CicloLeve lê as menstruações registradas no app Saúde, como as anotadas no Apple Watch, para manter seu ciclo atualizado.",
          "NSHealthUpdateUsageDescription": "O CicloLeve grava no app Saúde os dias de menstruação e os sintomas que você registra.",
          "background": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f66382fb-e1a1-46ad-a524-bd6ebd8ea2b6"
      }
    },
    "owner": "dlrodrigues021",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/f66382fb-e1a1-46ad-a524-bd6ebd8ea2b6",
      "fallbackToCacheTimeout": 0
    }
  }
}
